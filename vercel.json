{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/merge-pdfs",
      "dest": "/api/merge-pdfs.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/test",
      "dest": "/api/test.js",
      "methods": ["GET"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/not-found.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
} 